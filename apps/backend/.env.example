# 京东 Coding PAT（scope=api，在 coding.jd.com 用户设置→访问令牌创建）
CODING_TOKEN=
CODING_HOST=https://coding.jd.com
CODING_PROJECT_ID=968403

# doc 仓库根绝对路径（后端操作这个仓库的 content-repo/content/ 下文件）
CONTENT_REPO_PATH=/Users/liangyuanwen.1/joymaas-docs-system/doc

# 服务端口
PORT=3001

# SQLite 文件路径
DB_PATH=./data/app.sqlite

# Coding webhook 密钥（在 coding.jd.com 仓库设置→Webhooks 配置时填的 secret，作为 X-Gitlab-Token 校验）
# 留空则不校验（仅本地调试用）；生产必须填
WEBHOOK_SECRET=
