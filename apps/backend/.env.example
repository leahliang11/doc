# GitHub fine-grained PAT（仅授权 leahliang11/doc，Contents 与 Pull requests 读写）
# 只写入本机/云主机 .env，绝不要提交到 Git。
GITHUB_TOKEN=
GITHUB_OWNER=leahliang11
GITHUB_REPO=doc
GITHUB_API_URL=https://api.github.com

# Coding 历史兼容配置（当前审核链路不再使用，可留空）
CODING_TOKEN=
CODING_HOST=https://coding.jd.com
CODING_PROJECT_ID=968403

# doc 仓库根绝对路径（后端操作这个仓库的 content-repo/content/ 下文件）
CONTENT_REPO_PATH=/Users/liangyuanwen.1/joymaas-docs-system/doc

# 服务端口
PORT=3001

# SQLite 文件路径
DB_PATH=./data/app.sqlite

# Webhook 共享密钥（旧 Coding 的 X-Gitlab-Token 与 GitHub 的 HMAC 签名共用）
# GitHub Webhook 配置同一个 Secret，服务端校验 X-Hub-Signature-256。
# 留空则不校验（仅本地调试用）；生产必须填
WEBHOOK_SECRET=

# 后台登录令牌（生产必填，建议使用至少 32 位随机字符串）
ADMIN_TOKEN=
# 后台登录账号（页面登录使用；不要与云主机 SSH 密码复用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 内部全文与内部 Ask 独立令牌；不配置即关闭内部访问
INTERNAL_DOCS_TOKEN=
# 允许跨域访问后台 API 的来源，多个用逗号分隔；同源部署无需配置
CORS_ORIGINS=

# Joybuilder AI（dogfooding 用自家 JoyMaaS 模型）
# apikey 在 Joybuilder 控制台创建；走后端环境变量，前端只调 /api/ai/*
JOYBUILDER_API_KEY=
JOYBUILDER_BASE_URL=https://modelservice.jdcloud.com/v1
# 可选模型：DeepSeek-V4-Flash（默认，最快）/ DeepSeek-V4-Pro / jd/glm-5.2（带思维链）
JOYBUILDER_MODEL=DeepSeek-V4-Flash
# AI 日志开关：true 时记录 prompt/response 到 data/ai-log.jsonl + 延迟到 data/ai-metrics.json
AI_LOG=false
